{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/merge-guard.py\" --deny",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
