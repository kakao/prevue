#!/bin/bash
# 비대화형 CLI(FR-10). 데몬을 띄우고, HTTP로 명령을 보내고, JSON을 그대로 돌려준다(FR-11).
# 종료 코드: 0 성공 · 1 렌더/컴파일 실패(ok=false) · 2 사용법 · 3 데몬에 닿지 못함 (FR-13)
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# 클래스패스와 툴체인 경로는 Gradle이 써 준다 — 여기서 버전이나 경로를 다시 적지 않는다.
ENV_FILE="$ROOT/build/prevue-env"
# 로그와 pid 는 플러그인 밖에 둔다. 플러그인 경로에는 버전이 박혀 있어, 안에 두면 판올림한 순간
# 떠 있는 데몬의 흔적을 잃는다 — prevue log 도 못 찾고, 어느 데몬이 살아 있는지도 모르게 된다.
DAEMON_DIR="${PREVUE_HOME:-$HOME/.prevue}/daemons"

PORT_BASE=8791
PORT_SPAN=100
# 기본 포트는 없다. 저장소가 정해지면 자리도 정해지고, 안 정해지면 거부한다 —
# "일단 8791" 이 남의 저장소 데몬에게 말하게 만든 길이었다.
PORT="${PREVUE_PORT:-$PORT_BASE}"
BASE="http://127.0.0.1:$PORT"
use_port() { PORT="$1"; BASE="http://127.0.0.1:$PORT"; LOG="$DAEMON_DIR/daemon-$PORT.log"; }
# 사람에게 건네고 브라우저로 여는 뷰어 주소. --lang(PREVUE_LANG)이 있으면 뷰어 언어를 싣는다(D-110).
viewer_at() { printf 'http://127.0.0.1:%s/%s' "$1" "${PREVUE_LANG:+?lang=$PREVUE_LANG}"; }
viewer_url() { viewer_at "$PORT"; }

sha256_of() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi; }

# 포트를 저장소에서 **계산한다**. 빈자리를 먼저 온 순서로 나눠 주면 같은 저장소가 어제는 8791,
# 오늘은 8792 가 되고, 그 값을 아무도 미리 알 수 없어 호출마다 들고 다녀야 한다 —
# 그러다 한 번 빠뜨리면 남의 저장소 데몬에게 조용히 말한다. 그 상태 자체를 없앤다.
# 앱마다 데몬 하나라(D-50) 같은 저장소의 둘째 앱은 그 옆 빈자리에 앉는다 — 데몬은 자리가 아니라 그리는 모듈로 찾는다(seat_of).
port_of() {  # <저장소 키>
  local h; h="$(printf '%s' "$1" | sha256_of | cut -c1-8)"
  printf '%s' $(( PORT_BASE + 16#$h % PORT_SPAN ))
}

# 그 포트의 데몬이 물고 있는 저장소 키. 아무도 없으면 빈 문자열이다.
# 덤프·오버레이 경로에 키가 박혀 있어(dump_out 참고) status 한 줄에서 꺼낼 수 있다.
daemon_key() {
  daemon_status "$1" | key_of_status
}
key_of_status() { sed -n 's|.*"overlay":"[^"]*/\.prevue/projects/\([^"/]*\)/.*|\1|p' | head -1; }
# 그 포트의 데몬의 status 한 줄. 없으면 빈 문자열이다. 렌더러가 앱 클래스패스면 그 앱의 모듈을 전부 그린다 —
# 같은 앱의 모듈은 보드만 바꾸고, 앱에 없는 모듈은 그 데몬을 두고 새 자리에 하나 더 띄운다(D-50). 판정은 prevue_plan.py hosts·seat 다.
daemon_status() {  # <포트>
  curl -sf -m "${STATUS_WAIT:-2}" "http://127.0.0.1:$1/status" 2>/dev/null | tr -d '\n'
}
# 그 저장소에서 이 체크아웃이 띄운 살아 있는 데몬 — 한 줄에 포트·status. pid 파일의 포트만 물어본다.
# 다른 체크아웃(워크트리·옛 판)의 데몬은 남이다 — 그 자리는 차 있는 것으로 보고 비켜 띄운다(prevue_plan.py own).
repo_daemons() {  # <저장소 키>
  any_repo_daemons "$1" | python3 "$PLAN_PY" own "$ROOT" | sed '/^$/d'
  return 0
}
# 남의 체크아웃이 띄운 것까지 — warmup 이 갈아 끼우지 못하는 데몬을 알리려고 본다.
any_repo_daemons() {  # <저장소 키>
  local f p st
  for f in "$DAEMON_DIR"/daemon-*.pid; do
    [ -e "$f" ] || continue
    p="${f##*/daemon-}"; p="${p%.pid}"
    st="$(daemon_status "$p")"; [ -n "$st" ] || continue
    [ "$(printf '%s' "$st" | key_of_status)" = "$1" ] && printf '%s\t%s\n' "$p" "$st"
  done
  return 0
}
# 그 저장소에서 마지막으로 show·start 를 받은 데몬. 두 앱이 함께 담은 모듈(core:ui)이나 파일을 안 가리킨 명령(status·wait)이 그리로 간다.
mark_recent() { [ -n "${KEY:-}" ] && printf '%s' "$PORT" > "$DAEMON_DIR/recent-$KEY" 2>/dev/null; return 0; }
# 뷰어를 브라우저에 띄운다. "사람과 에이전트가 같은 화면을 본다"가 이 도구의 전제라,
# 데몬만 뜨고 화면이 안 열리면 전제가 반쪽이 된다 — 그래서 여는 쪽이 기본이다(--no-open 으로 끈다).
# 여는 것은 start 뿐이다. show 마다 열면 파일을 바꿀 때마다 탭이 쌓인다 — 다시 열려면 prevue open.
OPENED=true
open_viewer() {
  if [ -n "${PREVUE_PREPARATION:-}" ]; then OPENED=false; return 0; fi
  [ "${NO_OPEN:-0}" = 1 ] && { OPENED=false; return 0; }
  # Codex 샌드박스는 LaunchServices 를 막아 open 이 실패한다(kLSExecutableIncorrectFormat, 실측). 시도하지 않고
  # 응답에 opened:false 를 실어 에이전트가 주소를 건네게 한다 — 열자고 권한 상승을 부르면 start 를 샌드박스 안에 둔 뜻이 없다.
  [ "${CODEX_SANDBOX:-}" = seatbelt ] && { OPENED=false; return 0; }
  if command -v open >/dev/null 2>&1; then open "$(viewer_url)" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$(viewer_url)" >/dev/null 2>&1 &
  fi
  return 0
}

JDK="${PREVUE_JDK:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"
# 포트마다 데몬 하나이므로 로그·pid도 포트별로 둔다 — 두 모듈을 같이 띄우면 겹친다.
LOG="$DAEMON_DIR/daemon-$PORT.log"

usage() {
  # 명령 목록 · 명령별 설명은 bin/help 가 갖는다 — 여기와 두 곳에 적으면 어긋난다
  cat "$ROOT/bin/help/index.txt" >&2
  exit 2
}

post() {  # post <path> <json> [409 에 낼 종료 코드 — 겨냥한 줄의 노드가 여럿이면 2(D-69)]
  local res code
  res=$(curl -sS -m 120 -w '\n%{http_code}' -H 'Content-Type: application/json' -d "$2" "$BASE$1" 2>/dev/null) || { unreached_json; return 3; }
  code="${res##*$'\n'}"; echo "${res%$'\n'*}"
  case "$code" in 200) return 0 ;; 409) return "${3:-1}" ;; *) return 1 ;; esac
}

json_kv() {  # k=v 목록을 {"k":"v"} 로
  python3 -c 'import json,sys; print(json.dumps(dict(a.split("=",1) for a in sys.argv[1:])))' "$@"
}

jstr() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1],ensure_ascii=False))' "$1"; }

# ── 관찰 ────────────────────────────────────────────────────────────────────
# 무엇이 있는지 보고 무엇을 할지 정하는 일(모듈 · 변형 · 덤프 · 리소스 제공자 · health · Gradle 오류)은 전부 prevue_plan.py 가 한다.
# 여기는 인자를 모아 넘기고, 자리 계산·curl·Gradle 실행만 한다 — 판정이 두 곳이면 서로 다른 답을 낸다.
PLAN_PY="$ROOT/bin/prevue_plan.py"

# 경로는 dirname · basename · tr 을 띄우지 않고 셸 문자열로 자른다 — 저장소를 찾아 올라가는 한 단계마다 4ms 라
# 깊은 소스 파일 하나에 60ms, warmup 한 번에 0.1초를 넘었다(실측).
abspath() {  # 존재하는 경로만 받는다
  local p="$1" d=.
  while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done   # dirname · basename 처럼 끝의 / 는 없는 것으로
  if [ -d "$p" ]; then (cd "$p" && pwd)
  else
    case "$p" in */*) d="${p%/*}"; d="${d:-/}" ;; esac
    (cd "$d" 2>/dev/null && printf '%s/%s' "$PWD" "${p##*/}")
  fi
}

repo_root() {  # <경로> — 위로 올라가며 gradlew를 찾는다
  local d; d="$(abspath "$1")" || return 1
  [ -d "$d" ] || { d="${d%/*}"; d="${d:-/}"; }
  while [ ! -x "$d/gradlew" ] && [ "$d" != "/" ]; do d="${d%/*}"; d="${d:-/}"; done
  [ -x "$d/gradlew" ] || return 1
  printf '%s' "$d"
}

module_dir() { local m="${2#:}"; printf '%s/%s' "$1" "${m//://}"; }

# 프로젝트 설정이 말하는 Gradle JDK. **산출물을 구운 JDK 와 같아야 한다.** 툴체인을 고정하지 않은 저장소에서는
# Gradle 의 JDK 가 compileKotlin·JavaCompile 의 입력이라, 다른 JDK 로 부르면 AS 가 만든 산출물이 전부 UP-TO-DATE 를 잃고
# 다시 컴파일된다 — 실측(대형 앱 모듈): 셸의 JAVA_HOME 이 17 이고 AS 는 JBR 25 였을 때 클래스 21,187 + kapt 스텁 12,811 이 새로 구워져 분 단위.
# AS 는 gradleJvm 이 #GRADLE_LOCAL_JAVA_HOME 이면 <repo>/.gradle/config.properties 의 java.home 에 그 경로를 적어 둔다.
# 대상 저장소는 읽기만 한다. 빌드 로그로 못 찾았을 때의 마지막 폴백이다(gradle_jdk_pick).
gradle_jdk_of() {  # <repo> -> "<경로>\t<출처>"
  local repo="$1" v
  v="$(sed -n 's/^java\.home=//p' "$repo/.gradle/config.properties" 2>/dev/null | head -1 | sed 's/\\:/:/g; s/\\=/=/g')"
  [ -n "$v" ] && [ -x "$v/bin/java" ] && { printf '%s\t%s' "$v" ".gradle/config.properties"; return; }
  v="$(sed -n 's/.*name="gradleJvm" value="\([^"]*\)".*/\1/p' "$repo/.idea/gradle.xml" 2>/dev/null | head -1)"
  case "$v" in
    "#JAVA_HOME") [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && { printf '%s\t%s' "$JAVA_HOME" ".idea/gradle.xml (#JAVA_HOME)"; return; } ;;
    /*) [ -x "$v/bin/java" ] && { printf '%s\t%s' "$v" ".idea/gradle.xml"; return; } ;;
  esac
  v="$(sed -n 's/^org\.gradle\.java\.home=//p' "$repo/gradle.properties" 2>/dev/null | head -1)"
  [ -n "$v" ] && [ -x "$v/bin/java" ] && { printf '%s\t%s' "$v" "gradle.properties"; return; }
  # 프로젝트 기록도 빌드 로그도 없으면 ./gradlew 가 이 셸에서 스스로 고를 JDK(JAVA_HOME → PATH 의 java)로 짐작한다 —
  # AS 가 동기화한 저장소라면 위의 config.properties 가 있었을 것이다. 셸에 java 가 없을 때만 AS 번들 JBR.
  [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && { printf '%s\t%s' "$JAVA_HOME" "JAVA_HOME (guessed — no project record or build log)"; return; }
  v="$(java -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.home = //p' | head -1)"
  [ -n "$v" ] && [ -x "$v/bin/java" ] && { printf '%s\t%s' "$v" "java on PATH (guessed — no project record or build log)"; return; }
  [ -x "$JDK/bin/java" ] && { printf '%s\t%s' "$JDK" "AS bundled JBR (guessed — no java in the shell)"; return; }
  printf '%s\t%s' "" "none"
}

# 이 플러그인 버전이 쓰는 렌더러·컴파일러가 공유 툴체인에 이미 있는가. 버전은 빌드와 같은 카탈로그에서 읽는다.
shared_toolchain() {
  local kv lv
  kv="$(sed -n 's/^kotlin *= *"\([^"]*\)".*/\1/p' "$ROOT/gradle/libs.versions.toml" | head -1)"
  lv="$(sed -n 's/^layoutlib-data *= *"\([^"]*\)".*/\1/p' "$ROOT/gradle/libs.versions.toml" | head -1)"
  [ -n "$kv" ] && [ -n "$lv" ] && [ -d "$HOME/.prevue/toolchain/compiler-$kv" ] && [ -d "$HOME/.prevue/toolchain/layoutlib-$lv" ]
}

# warmup 이 Gradle 을 부를 JDK — 모듈의 최신 산출물을 구운 데몬(로그, 내려간 것도) → Prevue 가 지난번에 쓴 JDK → gradle_jdk_of 순(bin/jdk_rule.py).
# 누가 빌드했는지(AS·터미널·Prevue)는 따지지 않는다 — 가장 최신 산출물을 재사용하는 JDK 가 답이다(이슈 #4).
# ps 는 떠 있는지를 출처 문구에 적는 데만 쓴다. LC_ALL=C — 한국어 로캘에서는 lstart 가 "2026년 9월 28일 월요일 …"로 찍혀 못 읽는다(실측).
gradle_version_of() {  # <repo>
  sed -nE 's/.*gradle-([0-9][0-9.]*)-(bin|all)\.zip.*/\1/p' "$1/gradle/wrapper/gradle-wrapper.properties" 2>/dev/null | head -1
}
gradle_jdk_pick() {  # <repo> [<모듈 디렉터리>] -> "<경로>\t<출처>"
  local v
  v="$(LC_ALL=C ps -axo pid=,lstart=,command= 2>/dev/null \
       | python3 "$ROOT/bin/jdk_rule.py" "$(gradle_version_of "$1")" \
           "$HOME/.prevue/projects/$(repo_key "$1")/gradle-jdk" "$1" "${GRADLE_USER_HOME:-$HOME/.gradle}" "${2:-}" 2>/dev/null)"
  [ -n "$v" ] && { printf '%s' "$v"; return; }
  gradle_jdk_of "$1"
}

# 저장소 루트 → ~/.prevue/projects 아래의 키. daemon_key 가 돌려주는 것과 같은 문자열이다.
repo_key() { local k="${1//\//_}"; printf '%s' "${k#_}"; }

# 이 호출이 말할 자리. 그 저장소에서 그 모듈을 그리는 데몬이 살면 그 포트고(모듈을 안 주면 가장 최근 데몬),
# 없으면 계산한 자리부터 첫 빈자리다 — 다른 앱의 데몬이 앉은 자리는 건너뛴다(D-50). 해시가 겹쳐 남이 앉아 있을 때도 같다.
# 데몬은 status 로 다시 찾으므로 기억할 것은 없다.
seat_of() {  # <저장소 키> [모듈] [변형] -> 포트
  local home p i live
  live="$(repo_daemons "$1" | python3 "$PLAN_PY" seat "${2:-}" "${3:-}" "$(cat "$DAEMON_DIR/recent-$1" 2>/dev/null)")"
  # 바쁜 데몬은 status 가 늦다(렌더 줄 뒤에 선다). 살아 있는 데몬 기록이 있는데 못 찾았으면 더 기다려 한 번 더 묻는다 —
  # 그러지 않으면 우리 데몬의 자리를 남의 자리로 보고 옆 빈자리로 가 "데몬 없음"이 된다(실측 2026-10-23: 8859 대신 8860).
  if [ -z "$live" ] && [ -n "$(alive_records)" ]; then
    live="$(STATUS_WAIT=10 repo_daemons "$1" | python3 "$PLAN_PY" seat "${2:-}" "${3:-}" "$(cat "$DAEMON_DIR/recent-$1" 2>/dev/null)")"
  fi
  [ -n "$live" ] && { printf '%s' "$live"; return 0; }
  home="$(port_of "$1")"
  for i in $(seq 0 9); do
    p=$(( PORT_BASE + (home - PORT_BASE + i) % PORT_SPAN ))
    [ -z "$(daemon_key "$p")" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

# 인자가 가리키는 모듈과 변형("모듈 변형" 한 줄). 덤프면 그 project·variant(--classpath 가 먼저다 — --resources-from 은 리소스 제공자다),
# 소스 파일이면 놓인 모듈. 어느 앱의 데몬에게 말할지가 이것으로 정해진다(D-50).
target_of_args() {
  local a r prev="" dump=""
  for a in "$@"; do [ "$prev" = --classpath ] && dump="$a"; prev="$a"; done
  for a in ${dump:+"$dump"} "$@"; do
    [ -f "$a" ] || continue
    case "$a" in */.prevue/projects/*.json)
      python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("project",""), d.get("variant",""))' "$a" 2>/dev/null && return 0
      continue ;;
    esac
    r="$(repo_root "$a" 2>/dev/null)" || continue
    python3 "$PLAN_PY" module "$r" "$(abspath "$a")" plan 2>/dev/null && return 0
  done
  return 1
}

# 인자에서 저장소 키를 읽는다. 명령마다 인자 자리가 달라 이름이 아니라 실재로 고른다.
# 덤프 JSON(~/.prevue/projects/<키>/...)에는 키가 경로에 적혀 있고, 소스 파일은 gradlew 를 찾아 올라간다.
key_from_args() {
  local a k r
  for a in "$@"; do
    [ -e "$a" ] || continue
    k="$(printf '%s' "$a" | sed -n 's|.*/\.prevue/projects/\([^/]*\)/.*|\1|p')"
    [ -n "$k" ] && { printf '%s' "$k"; return 0; }
    r="$(repo_root "$a" 2>/dev/null)" && { repo_key "$r"; return 0; }
  done
  return 1
}

# 기록(pid 파일) 가운데 살아 있는 데몬을 가리킬 수 있는 것 — 한 줄에 포트 · 상태(daemon · unknown). 판정은 bin/daemon_records.py 다.
# 기록은 데몬이 끝나도 남고 pid 는 재부팅하면 다시 나눠 준다 — kill -0 만 보면 그 pid 를 물려받은 남의 프로세스를 산 데몬으로 읽어,
# 재부팅 뒤 start 가 "닿지 못한다"로 막혔다(실측 2026-10-05: 기록의 pid 419 가 root 의 systemsoundserverd).
# --clean 은 부팅 전에 쓴 죽은 기록을 지운다. 기록을 쓰는 start 만 준다 — 나머지 명령은 기록을 읽기만 한다.
alive_records() {  # [--clean] [포트…]
  local clean=""; [ "${1:-}" = --clean ] && { clean=--clean; shift; }
  python3 "$ROOT/bin/daemon_records.py" $clean "$DAEMON_DIR" "$@"
}
# 기록은 살아 있는 데몬을 가리키는데 HTTP 로 닿지 못하는 포트들. 이 셸이 네트워크를 못 쓰는 것이다 —
# Codex 의 기본 샌드박스(workspace-write · network_access=false)가 127.0.0.1 도 막는다(실측 2026-09-23: 같은 show 가
# 샌드박스에서는 daemon:false, 권한 상승 뒤에는 성공). 이걸 "데몬이 없다"로 읽으면 start 로 보내 둘째 데몬을 띄우려다
# 로그까지 덮어쓴다. 죽은 것과 닿지 못하는 것을 가른다.
unreachable_daemons() {  # [포트…]
  local p
  alive_records "$@" | while IFS="$(printf '\t')" read -r p _; do
    [ -n "$p" ] || continue
    curl -sf -m 2 "http://127.0.0.1:$p/status" >/dev/null 2>&1 || printf '%s\n' "$p"
  done
}
# 다시 띄우려고 내린다. 붙은 뷰어에 다시 시작을 알리고(끊김으로 보이지 않게), 뷰어가 있었으면 표시를 남겨
# 이어지는 start 가 새 탭을 열지 않게 한다 — 같은 자리에 뜬 새 데몬에 그 탭이 다시 붙는다.
restart_daemon() {  # <port>
  local n
  n="$(curl -sf -m 5 "http://127.0.0.1:$1/status" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("viewers") or 0)' 2>/dev/null)"
  mkdir -p "$DAEMON_DIR"
  if [ "${n:-0}" -gt 0 ]; then date +%s > "$DAEMON_DIR/reattach-$1"; else rm -f "$DAEMON_DIR/reattach-$1"; fi
  (use_port "$1"; post /shutdown '{"restart":true}' >/dev/null 2>&1) || true
}

# 데몬은 /shutdown 뒤 HTTP 를 먼저 닫고 감시·쓰기를 정리한 뒤 끝난다. 그 사이에 같은 자리로 새 데몬을 띄우면 힙 두 벌이 겹치고,
# status 는 pid 가 살아 있어 "닿지 못한다(샌드박스)"로 잘못 답한다 — 끝날 때까지 기다린다. 데몬이 30초에 스스로 강제 종료하므로 그보다 조금 더.
# 기록이 이 데몬을 가리키지 않으면(부팅 전 · 남이 물려받은 pid) 기다리지 않는다 — 남의 프로세스는 35초 내내 산다.
# kill -0 이 "not permitted"(샌드박스)면 살았는지 알 수 없다 — 그때도 기다리지 않는다.
await_exit() {  # <port>
  local pid; pid="$(cat "$DAEMON_DIR/daemon-$1.pid" 2>/dev/null)"
  [ -n "$pid" ] && [ -n "$(alive_records "$1")" ] || return 0
  for _ in $(seq 1 140); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.25; done
  return 1
}
# 종료 요청을 처리하지 못하는 데몬을 신호로 내린다 — 클래스를 못 읽는 데몬은 /shutdown 에 500 을 내고 스스로 끝나지도 않았다.
# 기록이 이 자리의 데몬을 가리킬 때만 보낸다(남이 물려받은 pid 는 건드리지 않는다). 끝났거나 알 수 없으면 0, 살아 있으면 1.
force_exit() {  # <port>
  local pid sig; pid="$(cat "$DAEMON_DIR/daemon-$1.pid" 2>/dev/null)"
  [ -n "$pid" ] && [ -n "$(alive_records "$1")" ] || return 0
  for sig in TERM KILL; do
    # 신호를 못 보냈으면(샌드박스 · 남의 권한) 끝난 것이 아니라 못 내린 것이다 — 이미 끝났을 때만 0
    kill -s "$sig" "$pid" 2>/dev/null || { case "$(kill -0 "$pid" 2>&1)" in *"No such process"*) return 0 ;; esac; return 1; }
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.25; done
  done
  return 1
}
# 이 데몬의 jar 복사본(D-125)을 지운다. 기록이 아직 산 데몬(살았는지 모르는 샌드박스 포함 · 다시 뜬 JVM)을 가리키면 그 데몬이 읽는 중이라 둔다.
drop_jars() {  # <port>
  [ -n "$(alive_records "$1")" ] || rm -rf "$DAEMON_DIR/daemon-$1.jars"
}
# /shutdown 을 보낸 자리를 끝까지 내린다. 요청이 HTTP 오류로 돌아왔으면(1) 기다리지 않고 신호로 간다 — 연결 자체가 안 되면(3)
# 이미 HTTP 를 닫고 정리 중일 수 있어 먼저 기다린다. 데몬은 /shutdown 뒤 30초에 스스로 끝나므로 35초 뒤에도 살았으면 멈춘 것이다.
bring_down() {  # <port> <post 의 종료 코드>
  if [ "$2" = 1 ]; then force_exit "$1"; else await_exit "$1" || force_exit "$1"; fi || return 1
  drop_jars "$1"
}
# $PORT 에 닿지 못했을 때의 답. curl 의 오류 문구는 샌드박스 차단과 빈 포트에서 같아("Couldn't connect to server")
# 가를 수 없다 — 기록으로 가른다. 살아 있으면 이 셸이 못 닿는 것이고 start 로 보내지 않는다.
unreached_json() {
  if [ -n "$(alive_records "$PORT")" ]; then
    echo "{\"ok\":false,\"error\":\"$NET_BLOCKED_MSG\",\"port\":$PORT,\"networkBlocked\":true}"
  else
    echo "{\"ok\":false,\"error\":\"No daemon ($BASE) — see what is missing with prevue health <file>\",\"daemon\":false}"
  fi
}
# 에이전트가 읽는 응답(show·start --show·wait)은 prevue_plan.py agent-view 가 추린다(NFR-18).
# 데몬만 없을 때의 show 응답. 할 일은 next 의 start 하나라 나머지 판정 필드는 싣지 않는다 — 다른 것이 빠졌으면
# 사람이 더 물을 때 답할 재료(variant · resourcesFrom 등)라 ask 와 함께 전부 싣는다.
UNREADY_VIEW='
import json, sys
raw = sys.stdin.read()
try: d = json.loads(raw)
except ValueError: sys.stdout.write(raw); sys.exit(0)
if d.get("missing") == ["daemon"]:
    d = {k: d[k] for k in ("ok", "missing", "next", "startNeedsEscalation", "viewer") if k in d}
print(json.dumps(d, ensure_ascii=False))
'
# start --show 의 준비 판정. status 를 읽어 다 그려졌으면 prevue wait 와 같은 모양을 찍고 0, 아니면 1.
SHOW_READY='
import json, sys
st = json.load(sys.stdin); b = st.get("board")
opened = {} if len(sys.argv) < 3 or sys.argv[2] != "false" else {"opened": False}
if b:
    cards = b.get("cards") or []
    if not cards or any(c.get("stale") or not c.get("rendered") for c in cards): sys.exit(1)
    print(json.dumps(dict({"ok": all(c.get("ok") is True for c in cards), "file": b.get("file"), "gen": b.get("gen"),
                           "complete": True, "viewer": sys.argv[1], "cards": cards}, **opened), ensure_ascii=False))
elif st.get("last"):
    print(json.dumps(dict(st["last"], viewer=sys.argv[1], **opened), ensure_ascii=False))
else:
    sys.exit(1)
'
NET_BLOCKED_MSG="The daemon is alive but this shell can't reach 127.0.0.1 — the sandbox is blocking the network. Don't restart the daemon; run this command again in a shell with network access (Codex: sandbox_workspace_write.network_access=true or escalated)"

# 떠 있는 데몬 — start 가 남긴 pid 파일의 포트만 물어본다. 100 자리를 다 두드리지 않는다.
# 한 줄에 포트·키·저장소 경로다. 키는 대조용이고 경로는 사람에게 보일 것이다.
live_daemons() {
  local f p st k r
  for f in "$DAEMON_DIR"/daemon-*.pid; do
    [ -e "$f" ] || continue
    p="${f##*/daemon-}"; p="${p%.pid}"
    st="$(curl -sf -m 2 "http://127.0.0.1:$p/status" 2>/dev/null)" || continue
    k="$(printf '%s' "$st" | sed -n 's|.*"overlay":"[^"]*/\.prevue/projects/\([^"/]*\)/.*|\1|p' | head -1)"
    [ -n "$k" ] || continue
    r="$(printf '%s' "$st" | sed -n 's|.*"repo":"\([^"]*\)".*|\1|p' | head -1)"
    printf '%s\t%s\t%s\n' "$p" "$k" "${r:-$k}"
  done
}

dump_out() {  # <repo> <module> <variant> — 덤프 JSON은 저장소 밖에 둔다(NFR-2)
  local key p; key="$(repo_key "$1")"
  p="$HOME/.prevue/projects/$key/${2#:}-$3.json"; printf '%s' "${p//:/_}"
}

# resolve — 관찰한 것을 한 줄 JSON으로 낸다. Gradle을 부르지 않는다.
# 종료 0 준비됨 · 1 툴체인·덤프 없음 · 2 고를 것이 남았다(스킬이 사람에게 묻는다)
plan_json() {  # <파일|""> <variant|""> <projdir|""> [module]
  local file="$1" variant="$2" proj="$3" repo module="${4:-}" toolchain=true
  repo="$(repo_root "${proj:-${file:-$PWD}}")" || {
    echo '{"ok":false,"error":"gradlew not found — give the repository root with --project"}'; return 2; }
  if [ -n "$module" ]; then
    [ "${module#:}" = "$module" ] && module=":$module"
  else
    module="$(python3 "$PLAN_PY" module "$repo" "$file" plan)" || { echo "$module"; return 2; }
  fi
  # build/ 가 비어도 받아 둔 렌더러·컴파일러가 있으면 있는 것이다 — 이 버전의 jar 는 start 가 굽는다(판올림 뒤 한 번, 승인 없음).
  [ -s "$ENV_FILE" ] || shared_toolchain || toolchain=false
  python3 "$PLAN_PY" plan "$repo" "$module" "$variant" "$file" "$toolchain" \
    "$(gradle_jdk_pick "$repo" "$(module_dir "$repo" "$module")")" "$HOME/.prevue/projects"
}

# health — resolve 의 판정에 데몬 생존을 더한다. 빠진 것을 **전부** missing 에 순서대로 싣는다 —
# 하나씩 말하면 툴체인을 승인받고 30초 뒤 덤프를 또 물어 대화가 두 번 끊긴다. 한 번에 알면 한 번에 묻는다.
# 종료 0 준비됨(데몬까지) · 1 빠진 것 있음 · 2 고를 것이 남았다
health_json() {  # <파일>
  local file="$1" plan rc r key seat mod alive=false viewer="" dst=""
  plan="$(plan_json "$file" "" "")"; rc=$?
  local blocked=false
  if r="$(repo_root "$file" 2>/dev/null)"; then
    key="$(repo_key "$r")"
    mod="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("module",""))' 2>/dev/null)"
    if seat="$(seat_of "$key" "$mod")" && [ -n "$(daemon_key "$seat")" ]; then
      alive=true; viewer="$(viewer_at "$seat")"; dst="$(daemon_status "$seat")"
    elif [ -n "$seat" ] && unreachable_daemons "$seat" | grep -qx "$seat"; then
      blocked=true; viewer="$(viewer_at "$seat")"
    fi
  fi
  local unbaked=false; [ -s "$ENV_FILE" ] || unbaked=true
  python3 "$PLAN_PY" health "$plan" "$rc" "$alive" "$viewer" "$file" "$dst" "$blocked" "$NET_BLOCKED_MSG" "$unbaked"
}

# show 가 이 파일을 그릴 데몬을 못 찾았을 때. 빠진 것이 데몬 하나뿐이면 next 의 start 를 여기서 치고 show 를 한 번 다시 부른다 —
# 에이전트가 종료 3 을 받아 그 start 를 그대로 치던 한 호출이다(재실측 10회차 모두, NFR-17). 툴체인 · 덤프 · 고를 것이 남았으면
# 승인이나 사람의 답이 들어 health 모양으로 3 — 에이전트가 ask 를 묻는다. 다시 부른 show 는 또 띄우지 않는다.
show_unready() {  # <파일> — 돌아오지 않는다
  local h start=() line out rc
  h="$(health_json "$1" | python3 "$PLAN_PY" prepare-request)"
  if [ -z "${PREVUE_AUTOSTARTED:-}" ]; then
    while IFS= read -r line; do start+=("$line"); done < <(printf '%s' "$h" | python3 "$PLAN_PY" autostart)
    if [ ${#start[@]} -gt 0 ]; then
      out="$("$ROOT/bin/prevue" start "${start[@]}" --show "$1")"; rc=$?
      [ "$rc" = 0 ] || [ "$rc" = 1 ] || { echo "$out"; exit "$rc"; }   # 1 은 그림 실패 · 저장 전 그림 — 데몬은 떴다
      # 브라우저를 못 열었으면(샌드박스) 그 사실은 start 의 답에만 있다 — 버리면 에이전트가 "열렸다"고 말하고 사람은 빈 화면을 본다
      case "$out" in *'"opened": false'*|*'"opened":false'*) export PREVUE_NOT_OPENED=1;; esac
      PREVUE_AUTOSTARTED=1 exec "$ROOT/bin/prevue" show ${SHOW_ARGS[@]+"${SHOW_ARGS[@]}"}
    fi
  fi
  printf '%s' "$h" | python3 -c "$UNREADY_VIEW"; exit 3
}
WITH_STARTED='
import json, os, sys
raw = sys.stdin.read()
try: d = json.loads(raw)
except ValueError: sys.stdout.write(raw); sys.exit(0)
if isinstance(d, dict):
    d["started"] = True
    if os.environ.get("PREVUE_NOT_OPENED"):
        d["opened"] = False
print(json.dumps(d, ensure_ascii=False))
'

# --lang 은 명령 앞에도 올 수 있다 — 도움말 색인이 명령과 따로 적는다
LANG_GIVEN=""
while [ "${1:-}" = --lang ]; do [ $# -ge 2 ] || usage; LANG_GIVEN="$2"; shift 2; done
cmd="${1:-}"; shift || usage

# 명령 설명은 스킬이 아니라 CLI 가 갖는다(D-55) — 칠 때만 읽히고, 데몬 · python3 없이 답한다.
HELP_DIR="$ROOT/bin/help"
case "$cmd" in
  -h|--help|help) H="${1:-index}"; [ -f "$HELP_DIR/$H.txt" ] || H=index; cat "$HELP_DIR/$H.txt"; exit 0 ;;
esac
for a in "$@"; do
  case "$a" in -h|--help) [ -f "$HELP_DIR/$cmd.txt" ] && { cat "$HELP_DIR/$cmd.txt"; exit 0; }; cat "$HELP_DIR/index.txt"; exit 0 ;; esac
done
# 모르는 명령은 저장소를 찾기 전에 사용법으로 — 여태는 "어느 저장소인지 정할 수 없다"로 엉뚱한 이유를 댔다
case "$cmd" in index|failures) usage ;; esac   # 도움말 주제일 뿐 명령이 아니다
[ -f "$HELP_DIR/$cmd.txt" ] || usage

# 판정·JSON·데몬 기동이 python3 에 기댄다. macOS 의 /usr/bin/python3 는 Command Line Tools 로 넘기는 껍데기라,
# CLT 가 없으면 부르는 순간 설치 창이 뜨고 명령은 알 수 없는 오류로 끝난다 — 부르기 전에 가려 사람이 읽을 이유를 준다.
# 매 호출에 붙으므로 python 을 띄우지 않고 경로와 xcode-select 만 본다.
PY3="$(command -v python3 2>/dev/null)"
if [ -z "$PY3" ] || { [ "$PY3" = /usr/bin/python3 ] && [ "$(uname)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1; }; then
  # health 와 같은 모양으로 답하고 물을 문장(ask)도 싣는다 — python 없이 JSON 문자열로 옮기므로 \ 와 " 만 이스케이프한다.
  # 종료 코드도 health 규칙(빠진 것 있음 1)과 show 규칙(준비 안 됨 3)을 따른다.
  ASK="$(sed 's/\\/\\\\/g; s/"/\\"/g' "$ROOT/bin/help/ask/python3.txt" | tr -d '\n')"
  echo '{"ok":false,"missing":["python3"],"error":"No python3 — macOS Command Line Tools are needed","next":"xcode-select --install","ask":"'"$ASK"'"}'
  [ "$cmd" = health ] && exit 1 || exit 3
fi

# setup·warmup 은 Gradle 이 ~/.gradle 에 써서 Codex 샌드박스 안에서는 늘 실패한다(~/.gradle 락 Operation not permitted, 실측).
# 실패를 기다리지 않고 바로 돌려보낸다. start 는 데몬이 headless 라 샌드박스 안에서 뜬다 — 창 앱이던 때는 Abort trap 6 이었다.
# CODEX_SANDBOX 는 seatbelt 로 띄운 명령에만 붙고 샌드박스 밖 실행에는 없다(codex sandbox 로 확인).
case "$cmd" in setup|warmup)
  if [ "${CODEX_SANDBOX:-}" = seatbelt ]; then
    echo "{\"ok\":false,\"needsEscalation\":true,\"error\":\"$cmd doesn't run inside the Codex sandbox — run the same command again outside the sandbox (escalated)\"}"
    exit 1
  fi ;;
esac

# --port 는 어느 명령에나 붙을 수 있어야 한다. 여태 start 만 파싱해서 show 는 사용법으로 죽고
# status 는 조용히 8791 의 남의 데몬에게 물었다. 여기서 한 번에 걷는다.
PORT_GIVEN=0
[ -n "${PREVUE_PORT:-}" ] && PORT_GIVEN=1
ARGV=()
while [ $# -gt 0 ]; do
  case "$1" in
    --port) use_port "$2"; PORT_GIVEN=1; shift 2;;
    --lang) [ $# -ge 2 ] || usage; LANG_GIVEN="$2"; shift 2;;
    *) ARGV+=("$1"); shift;;
  esac
done
set -- ${ARGV[@]+"${ARGV[@]}"}
# 뷰어 언어는 이 호출이 부르는 것(준비 화면 · 다시 부르는 bin/prevue · prevue_plan.py)이 환경으로 이어받는다.
# 주소와 JSON 에 그대로 실리므로 언어 태그 모양만 받는다. 셸에 남은 로캘 모양(ko_KR.UTF-8)은 버린다 — 명령을 막지 않는다.
lang_tag() { printf '%s' "$1" | grep -Eq '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$'; }
if [ -n "$LANG_GIVEN" ]; then
  lang_tag "$LANG_GIVEN" || { echo '{"ok":false,"error":"--lang takes a language tag such as ko, en or pt-BR"}'; exit 2; }
  PREVUE_LANG="$LANG_GIVEN"
elif [ -n "${PREVUE_LANG:-}" ] && ! lang_tag "$PREVUE_LANG"; then
  PREVUE_LANG=""
fi
export PREVUE_LANG="${PREVUE_LANG:-}"

# 그리고 대개는 아무도 --port 를 안 쓴다. 이 호출이 **어느 저장소를 말하는지**를 먼저 정하고,
# 자리는 그 저장소에서 계산한다(port_of). 에이전트가 포트를 기억할 일이 없어지고,
# 기억이 틀려 남의 데몬에게 말하는 길이 닫힌다.
case "$cmd" in
  resolve|health|setup|warmup|paths) ;;          # 데몬에 말하지 않는다. health 는 자리를 스스로 본다
  stop) case "${1:-}" in --all|--mine) ;; *) RESOLVE_SEAT=1 ;; esac ;;   # --all·--mine 은 저장소를 안 가리킨다
  *) RESOLVE_SEAT=1 ;;
esac
if [ "${RESOLVE_SEAT:-0}" = 1 ]; then
    if [ "$PORT_GIVEN" = 0 ]; then
      # 인자가 가리킨 저장소는 그대로 따른다. cwd 는 약한 단서라, 거기 데몬이 실제로 살 때만 쓴다 —
      # 에이전트의 작업 디렉터리가 대상 저장소가 아닌 경우가 흔하고(이 도구의 plugin/ · 픽스처에도 gradlew 가 있다),
      # 그때 엉뚱한 빈자리를 골라 "닿지 못했다"로 끝내면 이유를 알 수 없다.
      KEY="$(key_from_args "$@")" || KEY=""
      if [ -z "$KEY" ] && R="$(repo_root "$PWD" 2>/dev/null)"; then
        C="$(repo_key "$R")"; S="$(seat_of "$C")" && [ -n "$(daemon_key "$S")" ] && KEY="$C"
      fi
      if [ -n "$KEY" ]; then
        # 같은 저장소에도 앱마다 데몬이 따로다 — 인자가 가리킨 모듈을 그리는 데몬, 없으면 새 자리(D-50).
        TARGET="$(target_of_args "$@")" || TARGET=""
        S="$(seat_of "$KEY" ${TARGET:+$TARGET})" || { echo "{\"ok\":false,\"error\":\"No free seat — all ten seats are held by other repositories. Give one with --port\"}"; exit 3; }
        use_port "$S"
      else
        # 저장소를 못 정했다. 떠 있는 데몬이 하나뿐이면 고를 것이 없으므로 그것으로 본다.
        # 아니면 **거부한다.** 여기서 8791 같은 기본값으로 떨어지는 것이 여태의 함정이었다 —
        # 모르면 모른다고 해야지, 마침 거기 있던 남의 데몬에게 말해서는 안 된다.
        LIVE="$(live_daemons)"; N=0; [ -n "$LIVE" ] && N="$(printf '%s\n' "$LIVE" | wc -l | tr -d ' ')"
        if [ "$N" = 1 ]; then use_port "$(printf '%s' "$LIVE" | cut -f1)"
        elif [ "$N" = 0 ]; then
          U="$(unreachable_daemons | tr '\n' ' ')"
          if [ -n "$U" ]; then
            echo "{\"ok\":false,\"error\":\"$NET_BLOCKED_MSG\",\"unreachable\":[$(printf '%s' "$U" | sed 's/ *$//; s/ /,/g')],\"networkBlocked\":true}"; exit 3
          fi
          echo "{\"ok\":false,\"error\":\"No running daemon — point at a file path to find that repository's seat\"}"; exit 3
        else
          # 후보를 실어 보낸다. awk 로 조립하면 따옴표가 셸·awk·JSON 세 겹을 지나며 깨진다 — 셸로만 짠다.
          LIST=""
          while IFS="$(printf '\t')" read -r lp lk lr; do
            [ -n "$lp" ] || continue
            LIST="$LIST${LIST:+,}{\"port\":$lp,\"repo\":\"$lr\"}"
          done <<EOF
$LIVE
EOF
          echo "{\"ok\":false,\"error\":\"Can't tell which repository — point at it with a file path or --project\",\"daemons\":[$LIST]}"
          exit 2
        fi
      fi
    fi
fi

case "$cmd" in
  resolve)
    FILE=""; VARIANT=""; PROJ=""
    while [ $# -gt 0 ]; do case "$1" in
      --variant) VARIANT="$2"; shift 2;;
      --project) PROJ="$2"; shift 2;;
      -*) usage;;
      *) FILE="$(abspath "$1" 2>/dev/null)" || { echo "{\"ok\":false,\"error\":\"No such file: $1\"}"; exit 2; }; shift;;
    esac; done
    plan_json "$FILE" "$VARIANT" "$PROJ"; exit $?
    ;;
  health)
    FILE=""
    while [ $# -gt 0 ]; do case "$1" in
      -*) usage;;
      *) FILE="$(abspath "$1" 2>/dev/null)" || { echo "{\"ok\":false,\"error\":\"No such file: $1\"}"; exit 2; }; shift;;
    esac; done
    # 파일 없는 답은 "툴체인만 있어도 ok" 로 읽혀 덤프를 건너뛰게 한다. 준비됐다는 것은 언제나 어느 모듈을 그리기에 준비됐다는 뜻이다.
    [ -n "$FILE" ] || { echo '{"ok":false,"error":"A file is needed to decide the module — prevue health <file>"}'; exit 2; }
    health_json "$FILE"; exit $?
    ;;
  setup)
    # 툴체인만 받는다. 덤프 인자가 붙어 오면 돌리지 않고 warmup 으로 보낸다 — 외부망 435MB 와
    # 대상 저장소의 Gradle 은 다른 승인이라 한 명령이 인자 유무로 둘을 갈아타게 두지 않는다.
    OFFLINE=0; [ "${1:-}" = --offline ] && { OFFLINE=1; shift; }
    if [ $# -gt 0 ]; then
      python3 -c 'import json,sys; print(json.dumps({"ok":False,"error":"setup only downloads the toolchain — the dump is warmup","next":"prevue warmup " + " ".join(sys.argv[1:])},ensure_ascii=False))' "$@" \
        | python3 "$PLAN_PY" with-lang
      exit 2
    fi
    HAD=false; [ -s "$ENV_FILE" ] && HAD=true
    # 래퍼는 JAVA_HOME 을 따른다. 없으면 데몬이 쓰는 것과 같은 JBR 을 준다 — 셸의 java 가 17 인 것이 AGP 세계의 기본값이다.
    [ -n "${JAVA_HOME:-}" ] || { [ -d "$JDK" ] && export JAVA_HOME="$JDK"; }
    if [ "$OFFLINE" = 1 ]; then
      # 받아 둔 것만으로 굽는다. 모자라면 새로 받아야 하므로 승인이 필요한 setup 으로 돌려보낸다.
      if ! (cd "$ROOT" && ./gradlew installPrevue -q --offline) >&2; then
        echo '{"ok":false,"missing":["toolchain"],"error":"Cannot build from the downloaded components — they need to be downloaded again","next":"prevue setup"}' | python3 "$PLAN_PY" with-lang; exit 1
      fi
    elif ! (cd "$ROOT" && ./gradlew installPrevue -q) >&2; then
      echo '{"ok":false,"error":"The toolchain build failed — the cause is in the Gradle output above"}'; exit 1
    fi
    [ -s "$ENV_FILE" ] || { echo "{\"ok\":false,\"error\":\"The build finished but $ENV_FILE is missing\"}"; exit 1; }
    echo "{\"ok\":true,\"toolchain\":true,\"alreadyHad\":$HAD}"
    ;;
  warmup)
    if [ -z "${PREVUE_PREPARATION:-}" ]; then
      for arg in "$@"; do
        if [ "$arg" = --show ]; then exec python3 "$ROOT/bin/prevue_prepare.py" run warmup "$PORT" "$@"; fi
      done
    fi
    # 클래스패스 덤프를 사람 대신 돌린다. init-script 주입이라 대상 저장소에는 아무것도 남지 않는다(NFR-2).
    MODULE=""; VARIANT=""; PROJ=""; OUT=""; FILE=""; RESFROM=""
    while [ $# -gt 0 ]; do case "$1" in
      --module) MODULE="$2"; shift 2;;
      --variant) VARIANT="$2"; shift 2;;
      --project) PROJ="$2"; shift 2;;
      --resources-from) RESFROM="$2"; shift 2;;
      --out) OUT="$2"; shift 2;;
      --no-open) NO_OPEN=1; shift;;
      -*) usage;;
      *) FILE="$(abspath "$1" 2>/dev/null)" || { echo "{\"ok\":false,\"error\":\"No such file: $1\"}"; exit 2; }; shift;;
    esac; done

    GIVEN="${PROJ:-${FILE:-$PWD}}"
    ROOTDIR="$(repo_root "$GIVEN")" || { echo "{\"ok\":false,\"error\":\"gradlew not found ($GIVEN) — give the repository root with --project\"}"; exit 2; }
    # 모듈은 파일이 놓인 자리다. 못 정하면 include 목록을 그대로 올려 보내고 스킬이 고른다.
    if [ -z "$MODULE" ]; then
      MODULE="$(python3 "$PLAN_PY" module "$ROOTDIR" "$FILE" warmup)" || { echo "$MODULE"; exit 2; }
    fi
    [ "${MODULE#:}" = "$MODULE" ] && MODULE=":$MODULE"

    # 변형은 plan_json 과 같은 규칙으로 찍는다 — 판정이 두 곳이면 health 가 "준비됨"이라 한 덤프를 warmup 이 다른 이름으로 뜬다.
    # JDK 는 모듈을 정한 뒤에 고른다 — 그 모듈의 최신 산출물을 구운 JDK 여야 한다. plan 이 고른 것을 그대로 쓴다(warmup_target).
    # 리소스를 빌릴 앱을 이미 알면(health 가 관찰로 골라 next 에 붙였거나 사람이 줬다) 그 덤프까지 Gradle 한 번에 뜬다 —
    # 이 모듈의 태스크는 앱 덤프의 부분집합이라 고정비(기동 · 설정 · 그래프)만 한 번 빠진다. 합칠지는 plan 이 가른다(combine_provider).
    PLAN=""; GJ=""
    if [ -z "$VARIANT" ]; then PLAN="$(plan_json "$FILE" "" "$PROJ" "$MODULE")"
    else GJ="$(gradle_jdk_pick "$ROOTDIR" "$(module_dir "$ROOTDIR" "$MODULE")")"
    fi
    TARGET="$(python3 "$PLAN_PY" warmup-target "$ROOTDIR" "$MODULE" "$VARIANT" "$RESFROM" "$PLAN" "$GJ")" \
      || { echo "$TARGET"; exit 2; }   # 관찰된 이름에 debug 계열이 없다 — 스킬이 사람에게 묻는다
    { IFS= read -r VARIANT; IFS= read -r VARIANT_BY; IFS= read -r GRADLE_JDK; IFS= read -r GRADLE_JDK_FROM; IFS= read -r RESV1; } <<< "$TARGET"
    VARIANT_GIVEN=0; [ "$VARIANT_BY" = given ] && VARIANT_GIVEN=1
    echo "prevue: Gradle JDK = ${GRADLE_JDK:-<none>} ($GRADLE_JDK_FROM)" >&2

    # Gradle 호출마다 회차 기록 한 줄 — 벽시계와 init 스크립트의 단계 시각(기동 · settings · 설정 · 그래프 · 실행)과 태스크 결과 수.
    # 고정비가 어디에 드는지를 회차마다 남긴다(`--profile`은 대상 저장소에 써서 못 쓴다).
    RUNS="$HOME/.prevue/projects/$(repo_key "$ROOTDIR")/warmup-runs.jsonl"
    GRADLE_CALLS=0; GRADLE_MS=0
    # 벽시계는 date 의 %N 으로 잰다 — python 을 띄우면 한 번에 25ms 다. %N 을 모르는 date(옛 macOS 는 "N" 을 찍는다)면 python 으로.
    now_ms() {
      local t; t="$(date +%s%N 2>/dev/null)"
      case "$t" in *[!0-9]*) t="" ;; esac
      if [ "${#t}" = 19 ]; then printf '%s\n' "${t%??????}"; else python3 -c 'import time; print(int(time.time() * 1000))'; fi
    }
    STAMP_SINCE_MS="$(now_ms)"   # 이 뒤에 바뀐 빌드 파일은 덤프가 봤는지 모른다(stamp)
    gradle_dump() {  # gradle_dump <모듈|변형|출력>... — Gradle 1회에 덤프 여럿. stderr 는 GRADLE_ERR 파일에 남긴다(부른 쪽이 지운다)
      local props=() tasks=() t m r v o d i=0 timing t0 rc=0 ms
      # 대상마다 번호 붙은 속성 셋 — 출력 경로(저장소 경로가 들어간다)에 어떤 글자가 있어도 갈리지 않는다
      for t in "$@"; do
        m="${t%%|*}"; r="${t#*|}"; v="${r%%|*}"; o="${r#*|}"
        props+=("-Dprevue.project.$i=$m" "-Dprevue.variant.$i=$v" "-Dprevue.out.$i=$o"); tasks+=("$m:prevueDumpClasspath")
        case "$o" in */*) d="${o%/*}"; mkdir -p "${d:-/}" ;; esac   # --out 이 파일 이름뿐이면 만들 디렉터리가 없다
        i=$((i + 1))
      done
      GRADLE_ERR="$(mktemp)"; timing="$(mktemp)"; t0="$(now_ms)"
      # Gradle 의 stderr 를 붙잡아 둔다. 덤프 스크립트가 멈춘 이유가 거기 있는데,
      # 여태 JSON 에는 "모듈 이름과 변형을 확인해라"만 실어서 — 모듈도 변형도 맞는 실패에
      # 엉뚱한 곳을 보게 했다. 사람에게는 그대로 흘려 보내고, 요지 한 줄은 JSON 에도 싣는다.
      (cd "$ROOTDIR" && JAVA_HOME="${GRADLE_JDK:-${JAVA_HOME:-}}" ./gradlew --init-script "$ROOT/gradle/dump-classpath.init.gradle.kts" \
        "${props[@]}" -Dprevue.timing="$timing" "${tasks[@]}" --no-configuration-cache \
        -Dorg.gradle.isolated-projects=false -q) 2>"$GRADLE_ERR" >&2 || rc=$?
      ms="$(python3 "$PLAN_PY" gradle-run "$timing" "$t0" "$(now_ms)" "$rc" "$RUNS" "$GRADLE_JDK" "$@" 2>/dev/null)"
      rm -f "$timing"
      GRADLE_CALLS=$((GRADLE_CALLS + 1)); GRADLE_MS=$((GRADLE_MS + ${ms:-0}))
      return $rc
    }

    dump() {  # dump <module> <out> [변형] [사람이 준 변형이면 1] — Gradle 1회. 변형을 안 주면 이 모듈의 것
      local v="${3:-$VARIANT}" given="${4:-$VARIANT_GIVEN}"; DUMP_RETRY=""
      echo "prevue: calling Gradle once in $ROOTDIR ($1 / $v)" >&2
      if ! gradle_dump "$1|$v|$2"; then
        cat "$GRADLE_ERR" >&2
        # 첫 줄은 다시 뜰 변형(없으면 빈 줄), 둘째 줄은 이유를 실은 응답이다
        local f; f="$(python3 "$PLAN_PY" dump-failure "$GRADLE_ERR" "$1" "$v" "$given")"
        rm -f "$GRADLE_ERR"
        DUMP_RETRY="${f%%$'\n'*}"; DUMP_ERR="${f#*$'\n'}"; return 1
      fi
      cat "$GRADLE_ERR" >&2; rm -f "$GRADLE_ERR"
      [ -s "$2" ] || { DUMP_ERR="{\"ok\":false,\"error\":\"The dump is empty — check that $1 has the android extension\"}"; return 1; }
    }

    [ -n "$OUT" ] || OUT="$(dump_out "$ROOTDIR" "$MODULE" "$VARIANT")"
    # 합친 호출(RESV1 — warmup_target 이 정했다)이 실패하면 하나씩 다시 뜬다 — 실패의 이유를 대상마다 가르고 변형을 다시 고르는
    # 길이 거기 있다. 그 stderr 는 하나씩 뜨며 대상마다 다시 나오므로 여기서는 버린다.
    BOTH=""; RF=""; RESOUT1=""
    if [ -n "$RESV1" ]; then
      RF=":${RESFROM#:}"; RESOUT1="$(dump_out "$ROOTDIR" "$RF" "$RESV1")"
      echo "prevue: calling Gradle once in $ROOTDIR ($MODULE / $VARIANT + $RF / $RESV1)" >&2
      if gradle_dump "$MODULE|$VARIANT|$OUT" "$RF|$RESV1|$RESOUT1" && [ -s "$OUT" ] && [ -s "$RESOUT1" ]; then
        BOTH=1; cat "$GRADLE_ERR" >&2
      else
        echo "prevue: couldn't take both at once — taking them one by one" >&2
      fi
      rm -f "$GRADLE_ERR"
    fi
    if [ -z "$BOTH" ] && ! dump "$MODULE" "$OUT"; then
      # Gradle 이 실재하는 debug 계열 후보를 말해 줬으면 같은 규칙으로 한 번만 다시 뜬다(dump_failure)
      V2="${DUMP_RETRY:-}"
      if [ -n "$V2" ]; then
        echo "prevue: there is no variant '$VARIANT' — picking $V2 by the rule and taking it again" >&2
        VARIANT="$V2"; OUT="$(dump_out "$ROOTDIR" "$MODULE" "$VARIANT")"
        dump "$MODULE" "$OUT" || { echo "$DUMP_ERR"; exit 1; }
      else
        echo "$DUMP_ERR"; exit 1
      fi
    fi

    # 자기 리소스 APK가 있으면 그걸로 끝이다. 없으면 어디서 빌릴지를 스킬이 고른다 —
    # "앱 모듈"이 무엇인지 여기서 정의하지 않는다. 디스크에 APK가 실제로 있는 곳만 보여 준다.
    RESOUT=""
    RESFROM="$(python3 "$PLAN_PY" warmup-resources "$ROOTDIR" "$MODULE" "$VARIANT" "$OUT" "$RESFROM" "$FILE")" || { echo "$RESFROM"; exit 2; }
    if [ -n "$BOTH" ] && [ "$RESFROM" = "$RF" ]; then
      RESV="$RESV1"; RESOUT="$RESOUT1"   # 위에서 이 모듈과 함께 떴다
    elif [ -n "$RESFROM" ]; then
      # 리소스 모듈의 변형은 그 모듈의 것이다 — 앱에만 플레이버가 있으면 이 모듈의 변형 이름이 그 앱에 없다.
      RESV="$(python3 "$PLAN_PY" resource-variant "$ROOTDIR" "$RESFROM" "$VARIANT")"
      RESOUT="$(dump_out "$ROOTDIR" "$RESFROM" "$RESV")"
      # 리소스 모듈의 변형은 늘 짐작이다(사람이 주지 않는다). 플레이버 앱을 한 번도 빌드하지 않은 클론은 관찰할 이름이 없어
      # 라이브러리 변형(debug)을 넘기게 되고 앱에는 fossDebug · gplayDebug만 있다(thunderbird · element-x) — 이 모듈과 같은 규칙으로 한 번 다시 뜬다.
      if ! dump "$RESFROM" "$RESOUT" "$RESV" 0; then
        [ -n "${DUMP_RETRY:-}" ] || { echo "$DUMP_ERR"; exit 1; }
        echo "prevue: $RESFROM has no variant '$RESV' — picking $DUMP_RETRY by the rule and taking it again" >&2
        RESV="$DUMP_RETRY"; RESOUT="$(dump_out "$ROOTDIR" "$RESFROM" "$RESV")"
        dump "$RESFROM" "$RESOUT" "$RESV" 0 || { echo "$DUMP_ERR"; exit 1; }
      fi
    fi

    # 이 JDK 로 구웠다 — 개발자의 데몬이 없을 때 다음 warmup 이 같은 JDK 로 제 산출물과 데몬을 재사용한다.
    [ -n "$GRADLE_JDK" ] && mkdir -p "${RUNS%/*}" && printf '%s\n' "$GRADLE_JDK" > "${RUNS%/*}/gradle-jdk"

    # 이 모듈을 그리는 데몬은 옛 덤프를 쥐고 있다 — start 는 같은 모듈의 데몬을 그대로 다시 쓰므로 next 를 쳐도 옛 클래스패스로 그리고,
    # Gradle 이 방금 다시 쓴 리소스 APK 를 열다 깨진다(이슈 #152: 15장이 전부 ZipException). 내 데몬은 내려 next 의 start 가 새로 띄우게 한다.
    # 남의 체크아웃이 띄운 데몬은 그 세션의 것이라 알리기만 한다 — 같은 릴리즈를 깐 다른 에이전트의 데몬은 내 것이다(D-64).
    # 내릴 데몬 · 덤프의 빌드 파일 지문 · 응답은 python 한 번에 정한다(warmup-finish) — 첫 두 줄이 내릴 포트 · 남의 포트, 나머지가 응답이다.
    # 응답을 못 만들어도(종료 1) 내릴 데몬은 내린다 — 옛 덤프를 쥔 데몬이 남으면 next 의 start 가 그것을 다시 쓴다(이슈 #152).
    FINISH="$(any_repo_daemons "$(repo_key "$ROOTDIR")" | python3 "$PLAN_PY" warmup-finish "$ROOTDIR" "$STAMP_SINCE_MS" "$MODULE" "$VARIANT" "$ROOT" \
      "$OUT" "$RESOUT" "$FILE" "$GRADLE_JDK" "$GRADLE_JDK_FROM" "$GRADLE_CALLS" "$GRADLE_MS" "$RUNS")"; RC=$?
    { IFS= read -r STOP; IFS= read -r OTHERS; } <<< "$FINISH"
    for lp in $STOP; do restart_daemon "$lp"; done
    for lp in $STOP; do await_exit "$lp" || true; done
    printf '%s\n' "${FINISH#*$'\n'*$'\n'}"
    exit $RC
    ;;
  start)
    if [ -z "${PREVUE_PREPARATION:-}" ] && [ -z "$(daemon_key "$PORT")" ]; then
      if ! unreachable_daemons "$PORT" | grep -qx "$PORT"; then
        case " $* " in
          *' --fg '*) ;;
          *) exec python3 "$ROOT/bin/prevue_prepare.py" run start "$PORT" "$@" ;;
        esac
      fi
    fi
    FG=0; ARGS=(); CP=""; SHOW=""
    while [ $# -gt 0 ]; do case "$1" in
      --fg) FG=1; shift;; --no-open) NO_OPEN=1; shift;;
      --classpath) CP="$2"; ARGS+=("$1" "$2"); shift 2;;
      --show) SHOW="$2"; ARGS+=("$1" "$2"); shift 2;;
      *) ARGS+=("$1"); shift;; esac; done
    # 판올림하면 플러그인 디렉터리가 새로 생겨 build/ 가 빈다. 받아 둔 툴체인으로 굽는 것은 승인이 없으니 여기서 한다 —
    # health 가 build 로 에이전트를 보내면 스킬 읽기·setup·health 재확인으로 모델 호출이 셋 더 들었다(Codex 실측).
    if [ ! -s "$ENV_FILE" ] && shared_toolchain; then
      # 굽기는 Gradle 이라 ~/.gradle 에 쓴다 — 샌드박스 안이면 이번 한 번만 권한 상승으로 다시 치게 한다.
      if [ "${CODEX_SANDBOX:-}" = seatbelt ]; then
        echo '{"ok":false,"needsEscalation":true,"error":"The first start after an update calls Gradle to build the executable — run the same command again outside the sandbox (escalated), just this once"}'
        exit 1
      fi
      echo "prevue: building this version's executable from the downloaded components (once after an update)" >&2
      [ -n "${JAVA_HOME:-}" ] || { [ -d "$JDK" ] && export JAVA_HOME="$JDK"; }
      (cd "$ROOT" && ./gradlew installPrevue -q --offline) >&2 || true
    fi
    [ -s "$ENV_FILE" ] || { echo "{\"ok\":false,\"missing\":[\"toolchain\"],\"error\":\"No toolchain — prevue setup\",\"next\":\"prevue setup\"}" | python3 "$PLAN_PY" with-lang; exit 3; }
    . "$ENV_FILE"

    # 자리는 전역에서 정했다(--classpath 의 덤프 경로에 저장소 키가, 덤프에 모듈이 들어 있다).
    # seat_of 는 그 모듈을 그리는 데몬이거나 빈 자리만 돌려주므로, 살아 있으면 그것이 우리 데몬이다 —
    # 두 번 띄우지 않고 그대로 쓴다. 다른 앱의 데몬은 건드리지 않는다(D-50).
    # 그 자리에 데몬이 살아 있으면 --port 를 직접 줬어도 새로 띄우지 않는다 — 띄우면 바인딩에 실패한 JVM 이 남고 로그를 덮어쓴다(실측).
    WANT=""; WANTV=""
    [ -n "$CP" ] && [ -f "$CP" ] && read -r WANT WANTV < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("project",""), d.get("variant",""))' "$CP" 2>/dev/null)
    if [ -n "$(daemon_key "$PORT")" ]; then
      ST="$(daemon_status "$PORT")"; HAVE="$(python3 "$PLAN_PY" daemon-module "$ST")"
      if [ -z "$WANT" ] || [ -z "$HAVE" ] || python3 "$PLAN_PY" hosts "$ST" "$WANT" "$WANTV"; then
        # 이 데몬이 그 모듈을 그린다 — 같은 모듈이거나 같은 앱의 모듈이다. --show 가 있으면 그 대상으로 **보드를 바꾼다** — 여태는 status 만 돌려주고
        # 대상을 버려서, 다른 파일을 --show 해도 옛 보드에 머물렀다(실측: 한 파일을 띄운 뒤 다른 파일을 --show).
        if [ -n "$SHOW" ]; then
          T="${SHOW%%#*}"; IDX="${SHOW#"$T"}"; IDX="${IDX#\#}"; [ -n "$IDX" ] || IDX=null
          [ "$T" = "${T#/}" ] && [ -e "$T" ] && T="$(cd "$(dirname "$T")" && pwd)/$(basename "$T")"
          RES=$(post /show "{\"target\":\"$T\",\"index\":$IDX,\"params\":{},\"by\":\"${PREVUE_BY:-cli}\"}"); RC=$?
          # show 와 같은 모양으로 답한다 — 보드면 다 그릴 때까지 기다려 wait 모양으로(start --show 의 약속이다)
          if [ "$RC" != 3 ] && printf '%s' "$RES" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("board") else 1)' 2>/dev/null; then
            RES=$(post /wait "{\"files\":[$(jstr "$T")],\"timeoutMs\":30000}"); RC=$?
            if [ "$RC" != 3 ]; then
              RES=$(printf '%s' "$RES" | python3 "$PLAN_PY" agent-view "$(viewer_url)"); AV=$?
              [ "$RC" = 0 ] && RC=$AV               # complete:false 면 1
            fi
          fi
          mark_recent; open_viewer; echo "$RES"; exit $RC
        fi
        mark_recent; open_viewer; curl -sf -m 2 "$BASE/status"; exit 0
      fi
      # 자리 계산은 그 모듈을 그리는 데몬이나 빈자리만 준다 — 여기는 --port 로 다른 앱의 데몬 자리를 직접 줬을 때뿐이다.
      # 그 데몬을 내리면 그 앱의 보드와 편집을 잃는다(D-50). 내리지 않고 거절한다.
      echo "{\"ok\":false,\"error\":\"That seat ($PORT) has another app's daemon drawing $HAVE — drop --port to start in a free seat\"}"; exit 3
    fi
    # 같은 덤프 모듈의 다른 변형을 그리는 데몬은 내리고 띄운다 — 모듈 하나에 데몬 둘이면 힙만 두 벌이고 저장마다 둘 다 다시 그린다.
    # 디렉터리는 데몬마다 갈려(D-64) 지우기로 부딪히지는 않는다. 다른 앱의 데몬은 그대로 둔다(D-50).
    if [ -n "$WANT" ] && [ -n "${KEY:-}" ]; then
      OV="/overlay/$(printf '%s' "${WANT#:}" | tr ':' '_')\""
      for lp in $(repo_daemons "$KEY" | grep -F "$OV" | cut -f1); do
        echo "prevue: stopping the daemon ($lp) drawing another variant of $WANT and starting $WANTV" >&2
        (use_port "$lp"; post /shutdown '{}' >/dev/null 2>&1); await_exit "$lp" || true
      done
    fi
    if unreachable_daemons "$PORT" | grep -qx "$PORT"; then
      echo "{\"ok\":false,\"error\":\"$NET_BLOCKED_MSG\",\"port\":$PORT,\"networkBlocked\":true}"; exit 3
    fi
    if [ -n "${PREVUE_PREPARATION:-}" ]; then
      python3 "$ROOT/bin/prevue_prepare.py" stage "$PREVUE_PREPARATION" "$BASE/"
    fi
    ARGS+=(--port "$PORT" --root "$ROOT")
    mkdir -p "$DAEMON_DIR"
    # 새 기록을 쓰기 전에 부팅 전의 죽은 기록을 치운다 — 쌓인 기록마다 다른 명령이 curl 을 친다
    alive_records --clean >/dev/null
    # layoutlib 17.0.x는 Java 21 바이트코드다. 힙 상한은 NFR-6 — worktree 셋과 함께 돌아도 절제한다.
    # GC 는 G1 이다(D-72). ParallelGC 는 한 번 넓힌 힙을 돌려주지 않아, 인터랙티브로 조작하면 쓰는 힙이 100MB대여도 RSS 가 2.5GB 를 넘었다.
    # 힙 상한 2GB 와 여유 비율 · 30초 주기 GC(D-127, 3초는 노는 데몬을 깨워 유휴 CPU 를 쓴다) — 큰 기기 · 1600dp 그림은 한 장이 거대 객체(70MB)라 G1 이 커밋을 상한까지 넓혀
    # 살아 있는 힙이 300~800MB 여도 footprint 봉우리가 3.6GB 였다. 기본 여유 비율(70%)은 GC 뒤에도 쓰는 양의 세 배를 쥔다.
    # headless 다. layoutlib 이 AWT 를 쓰면 macOS 가 이 JVM 을 창 앱으로 올려 독에 뜨고, 종료 뒤에는 "최근 앱"에
    # 실행 파일(java)이 exec 아이콘으로 남았다. 데몬은 창 없이 그림만 만드니 창 시스템에 붙을 이유가 없다(렌더·터치 실측).
    # 데몬은 체크아웃의 jar 가 아니라 자기 복사본으로 돈다(D-125). gradlew test · installPrevue 가 build/ 의 jar 를 제자리에서
    # 다시 구우면 떠 있던 데몬이 클래스를 못 읽고(NoClassDefFoundError) 그리기도 종료 요청도 처리하지 못했다.
    # 임시 파일에 쓴 뒤 mv 로 바꿔 끼운다 — 같은 자리에서 아직 끝나지 않은 옛 데몬은 열어 둔 옛 파일을 계속 읽는다.
    # 스스로 끝난 데몬(유휴 종료 · 죽음)의 복사본은 지울 곳이 stop 뿐이라 여기서 거둔다.
    for d in "$DAEMON_DIR"/daemon-*.jars; do [ -d "$d" ] || continue; d="${d##*/daemon-}"; drop_jars "${d%.jars}"; done
    JARS="$DAEMON_DIR/daemon-$PORT.jars"; mkdir -p "$JARS"
    OWN_JAR="${PREVUE_CP%%:*}"    # 우리 jar 가 맨 앞이다(prevueEnv)
    for j in "$OWN_JAR" "$PREVUE_BRIDGE"; do
      t="$JARS/.$(basename "$j").$$"
      cp "$j" "$t" && mv -f "$t" "$JARS/$(basename "$j")" \
        || { rm -f "$t"; echo "{\"ok\":false,\"error\":$(jstr "Couldn't copy $j to $JARS for the daemon to run from")}"; exit 1; }
    done
    DAEMON_CP="$JARS/$(basename "$OWN_JAR")${PREVUE_CP#"$OWN_JAR"}"
    RUN=("$JDK/bin/java" "-Xmx${PREVUE_HEAP:-2g}" -XX:+UseG1GC -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30 -XX:G1PeriodicGCInterval=30000 -Djava.awt.headless=true
      --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED
      --add-opens=java.desktop/sun.awt.image=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED
      -cp "$DAEMON_CP" prevue.daemon.MainKt
      --layoutlib "$PREVUE_LAYOUTLIB" --compiler "$PREVUE_COMPILER" --bridge "$JARS/$(basename "$PREVUE_BRIDGE")"
      --viewer "$PREVUE_VIEWER" ${ARGS[@]+"${ARGS[@]}"})
    # 렌더 스레드를 잃은 데몬은 같은 자리에 자기를 다시 띄운다(NFR-4) — 새 JVM 이 자기 pid 를 여기 고쳐 쓴다.
    export PREVUE_PID_FILE="$DAEMON_DIR/daemon-$PORT.pid"
    if [ "$FG" = 1 ]; then exec "${RUN[@]}"; fi
    # 에이전트의 셸 도구는 명령이 끝나면 그 프로세스 그룹을 통째로 죽인다 — Codex 에서 `nohup … &` 데몬이
    # 첫 렌더 직후 로그 한 줄 없이 사라졌다(실측 2026-09-23). 새 세션으로 떼어 내 그룹 밖으로 나간다.
    # macOS 에 setsid 가 없어 python 이 setsid 뒤 exec 한다 — 그래서 $! 가 그대로 java 의 pid 다.
    python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "${RUN[@]}" >"$LOG" 2>&1 </dev/null &
    echo $! > "$DAEMON_DIR/daemon-$PORT.pid"
    for _ in $(seq 1 60); do curl -sf -m 1 "$BASE/status" >/dev/null 2>&1 && break; sleep 0.5; done
    if ! curl -sf -m 2 "$BASE/status" >/dev/null; then
      # 죽은 이유는 로그에 있다. 경로만 주고 "읽어 봐라"로 끝내면 한 겹 아래에 묻힌다 —
      # 스택 프레임을 걷어낸 마지막 줄이 대개 그 이유다.
      WHY="$(grep -v '^[[:space:]]*at ' "$LOG" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -1 \
             | sed 's/\\/\\\\/g; s/"/\\"/g')"
      echo "{\"ok\":false,\"error\":\"The daemon didn't start${WHY:+ — $WHY}\",\"log\":\"$LOG\"}"; exit 3
    fi
    mark_recent; open_viewer
    # --show를 줬으면 그림이 나올 때까지 기다려서 돌려준다 — 에이전트가 start 한 번으로 PNG 경로를 얻게(FR-11).
    # status 의 preview 는 렌더를 **시작**할 때 찬다. 그걸 기준으로 돌아가면 카드가 전부 image:null 인 보드를 성공으로 받는다.
    # 보드면 카드 전부가 그 세대로 그려질 때까지, FQN 단건이면 첫 렌더가 끝나 last 가 찰 때까지 기다린다.
    # /wait 를 부르지 않는다 — 그것은 저장한 파일의 결과를 기다리고, --no-watch 면 거절된다. 여기서는 연 보드가 다 그려지길 본다.
    if [ -n "$SHOW" ]; then
      READY=""
      for _ in $(seq 1 120); do
        ST="$(curl -sf -m 2 "$BASE/status")" && READY="$(printf '%s' "$ST" | python3 -c "$SHOW_READY" "$(viewer_url)" "$OPENED")" && break
        sleep 0.5
      done
      if [ -z "$READY" ]; then
        echo "{\"ok\":false,\"failure\":\"TIMEOUT\",\"message\":\"The daemon started but the images weren't all ready within 60 seconds\",\"viewer\":\"$(viewer_url)\",\"log\":\"$LOG\"}"; exit 1
      fi
      printf '%s' "$READY" | python3 "$PLAN_PY" agent-view
      printf '%s' "$READY" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("ok") else 1)'; exit $?
    fi
    curl -sf -m 2 "$BASE/status"
    ;;
  show)
    SHOW_ARGS=("$@")
    T="${1:-}"; [ -n "$T" ] || usage; shift
    IDX=null; PARAMS=()
    while [ $# -gt 0 ]; do case "$1" in --index) IDX="$2"; shift 2;; --param) PARAMS+=("$2"); shift 2;; *) usage;; esac; done
    [ "$T" = "${T#/}" ] && [ -e "$T" ] && T="$(cd "$(dirname "$T")" && pwd)/$(basename "$T")"

    # 어느 데몬에게 말할지는 전역에서 이미 정했다 — 이 파일의 모듈을 그리는 데몬, 없으면 빈자리다.
    # 거기 데몬이 없으면 post 가 3으로 떨어지고, 아래에서 무엇이 없는지를 돌려준다 — next 의 start 가 새 자리에 띄운다(D-50).
    # --port 로 다른 앱의 데몬을 직접 가리켰을 때도 같은 길이다 — 데몬에게 물으면 "감시하지 않는 파일"로 1을 내는데,
    # 그건 고칠 수 없는 실패처럼 읽힌다.
    if [ -f "$T" ] && R="$(repo_root "$T" 2>/dev/null)" && M="$(python3 "$PLAN_PY" module "$R" "$T" plan 2>/dev/null)"; then
      ST="$(daemon_status "$PORT")"
      if [ -n "$ST" ] && ! python3 "$PLAN_PY" hosts "$ST" "$M"; then show_unready "$T"; fi
    fi
    P="{}"; [ ${#PARAMS[@]} -gt 0 ] && P=$(json_kv "${PARAMS[@]}")
    RES=$(post /show "{\"target\":\"$T\",\"index\":$IDX,\"params\":$P,\"by\":\"${PREVUE_BY:-cli}\"}"); RC=$?
    [ "$RC" = 0 ] && mark_recent
    if [ "$RC" = 3 ] && [ -f "$T" ]; then show_unready "$T"; fi
    [ -n "${PREVUE_AUTOSTARTED:-}" ] && RES=$(printf '%s' "$RES" | python3 -c "$WITH_STARTED")
    # 데몬은 첫 카드만 그리고 답하고 나머지는 뒤에서 채운다(뷰어가 먼저 보이게). 그 중간 모습을 에이전트가 해석하느라
    # 초 단위로 멈췄다 — 나머지는 장당 수십 ms라, 보드를 다 그릴 때까지 기다려 wait 와 같은 모양으로 답한다(start --show 와 같다).
    if [ "$RC" != 3 ] && printf '%s' "$RES" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("board") else 1)' 2>/dev/null; then
      SHOWN="$RES"
      RES=$(post /wait "{\"files\":[$(jstr "$T")],\"timeoutMs\":30000}"); RC=$?
      [ "$RC" = 3 ] && { echo "$RES"; exit 3; }
      # 탭을 열었나 옮겼나 · 상한으로 닫은 탭은 show 의 답에만 있다 — wait 모양에 옮겨 싣는다(D-54).
      RES=$(printf '%s' "$RES" | python3 "$PLAN_PY" agent-view "$(viewer_url)" "$SHOWN"); AV=$?
      [ "$RC" = 0 ] && RC=$AV                     # complete:false 면 1 — 인터랙티브 중이라 다른 카드는 옛 그림이다
    fi
    echo "$RES"; exit $RC ;;
  close)
    T="${1:-}"; [ -n "$T" ] || usage
    [ "$T" = "${T#/}" ] && [ -e "$T" ] && T="$(cd "$(dirname "$T")" && pwd)/$(basename "$T")"
    post /close "{\"target\":$(jstr "$T"),\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  previews)
    F="${1:-}"; [ -n "$F" ] || usage; [ "$F" = "${F#/}" ] && F="$(cd "$(dirname "$F")" && pwd)/$(basename "$F")"
    post /previews "{\"file\":\"$F\"}" ;;
  open)
    curl -sf -m 2 "$BASE/status" >/dev/null 2>&1 \
      || { unreached_json; exit 3; }
    # 샌드박스에서는 열지 못한다 — 여태 ok 만 돌려줘 에이전트가 "열었다"고 말하고 사람은 빈 화면을 봤다(Codex 실측).
    open_viewer
    if [ "$OPENED" = true ]; then echo "{\"ok\":true,\"viewer\":\"$(viewer_url)\"}"
    else echo "{\"ok\":true,\"opened\":false,\"viewer\":\"$(viewer_url)\",\"message\":\"This shell can't open a browser — give the person the viewer address as a link\"}"; fi ;;
  board) curl -sf -m 5 "$BASE/board" || { unreached_json; exit 3; } ;;
  card)
    I="${1:-}"; [ -n "$I" ] || usage; shift; F=false
    while [ $# -gt 0 ]; do case "$1" in --force) F=true; shift;; *) usage;; esac; done
    post /card "{\"index\":$I,\"force\":$F,\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  focus)
    # 크기 · 기기는 켜진 카드에만 — 이미 켜져 있으면 크기만 바꾸고 인터랙티브는 그대로다
    I="${1:-}"; [ -n "$I" ] || usage; shift; ON=true; SZ=null; DEV=null; FOLD=false; LAND=false
    while [ $# -gt 0 ]; do case "$1" in
      --on) ON=true; shift;; --off) ON=false; shift;;
      --size) [ $# -ge 2 ] || usage; SZ=$(jstr "$2"); shift 2;;
      --device) [ $# -ge 2 ] || usage; DEV=$(jstr "$2"); shift 2;;
      --folded) FOLD=true; shift;; --landscape) LAND=true; shift;;
      *) usage;;
    esac; done
    post /focus "{\"index\":$I,\"interactive\":$ON,\"size\":$SZ,\"device\":$DEV,\"folded\":$FOLD,\"landscape\":$LAND,\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  reload)
    FILES=(); for f in "$@"; do [ "$f" = "${f#/}" ] && f="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"; FILES+=("$f"); done
    J=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' ${FILES[@]+"${FILES[@]}"})
    post /reload "{\"files\":$J,\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  wait)
    # 저장 뒤 "조금 기다렸다 status"를 대신한다. 응답이 곧 이 저장의 결과다 — 일찍 읽어 옛 그림을 믿는 일이 없다.
    # curl 의 상한(post, 120초) 안에 들도록 110초에서 자른다.
    FILES=(); TMO=30
    while [ $# -gt 0 ]; do case "$1" in
      --timeout) TMO="${2%s}"; shift 2;;
      -*) usage;;
      *) f="$1"; [ "$f" = "${f#/}" ] && f="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"; FILES+=("$f"); shift;;
    esac; done
    [ "$TMO" -gt 110 ] 2>/dev/null && TMO=110
    J=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' ${FILES[@]+"${FILES[@]}"})
    RES=$(post /wait "{\"files\":$J,\"timeoutMs\":$((TMO * 1000))}"); RC=$?
    printf '%s' "$RES" | python3 "$PLAN_PY" agent-view; AV=$?   # complete:false 면 1
    [ "$RC" = 0 ] && exit $AV; exit $RC ;;
  render)
    FRESH=false; AT=null
    while [ $# -gt 0 ]; do case "$1" in --fresh) FRESH=true; shift;; --at) AT="${2%ms}"; shift 2;; *) usage;; esac; done
    post /render "{\"fresh\":$FRESH,\"at\":$AT,\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  touch)
    # 좌표(PNG px) 또는 --at <파일>:<라인>[#N] — 겨냥은 데몬이 지금 화면의 트리에서 한다(D-69)
    TYPE=tap; SETTLE=true; AT=""; XY=()
    while [ $# -gt 0 ]; do case "$1" in
      --no-settle) SETTLE=false; shift;;
      --at) [ $# -ge 2 ] || usage; AT="$2"; shift 2;;
      tap|press|drag|release|long) TYPE="$1"; shift;;
      *) XY+=("$1"); shift;;
    esac; done
    if [ -n "$AT" ]; then
      [ ${#XY[@]} -eq 0 ] || usage
      post /touch "{\"at\":$(jstr "$AT"),\"type\":\"$TYPE\",\"settle\":$SETTLE,\"by\":\"${PREVUE_BY:-cli}\"}" 2
    else
      [ ${#XY[@]} -eq 2 ] || usage
      post /touch "{\"x\":${XY[0]},\"y\":${XY[1]},\"type\":\"$TYPE\",\"settle\":$SETTLE,\"by\":\"${PREVUE_BY:-cli}\"}"
    fi ;;
  scroll)
    # 겨냥 없이 화면 수만큼 굴린다(D-76) — --at 은 굴릴 컨테이너를 고르기만 한다. --until 이면 양은 상한이고 대상이 다 보이면 멈춘다(D-80)
    AMOUNT=1; HORIZONTAL=false; AT=null; UNTIL=null; GOT=0
    while [ $# -gt 0 ]; do case "$1" in
      --horizontal) HORIZONTAL=true; shift;;
      --at) [ $# -ge 2 ] || usage; AT=$(jstr "$2"); shift 2;;
      --until) [ $# -ge 2 ] && [ -n "$2" ] || usage; UNTIL=$(jstr "$2"); shift 2;;
      *) [ $GOT -eq 0 ] && printf '%s' "$1" | grep -Eq '^-?((0|[1-9][0-9]*)(\.[0-9]*)?|\.[0-9]+)$' || usage; AMOUNT="$1"; GOT=1; shift;;
    esac; done
    case "$AMOUNT" in .*) AMOUNT="0$AMOUNT";; -.*) AMOUNT="-0${AMOUNT#-}";; esac
    case "$AMOUNT" in *.) AMOUNT="${AMOUNT}0";; esac
    # 양을 안 줬으면 보내지 않는다 — 기본(한 화면, --until 이면 상한 10화면)은 데몬이 갖는다
    SCREENS="\"screens\":$AMOUNT,"; [ $GOT -eq 0 ] && SCREENS=""
    post /scroll "{$SCREENS\"horizontal\":$HORIZONTAL,\"at\":$AT,\"until\":$UNTIL,\"by\":\"${PREVUE_BY:-cli}\"}" 2 ;;
  type)
    [ $# -eq 1 ] || usage
    post /type "{\"text\":$(jstr "$1"),\"by\":\"${PREVUE_BY:-cli}\"}" ;;
  selection)
    # 없으면 1로 끝낸다 — 스킬이 "비어 있으면 추측하지 말고 가리켜 달라고 말한다"를 종료 코드로 판정한다.
    REF=0; while [ $# -gt 0 ]; do case "$1" in --ref) REF=1; shift;; *) usage;; esac; done
    RES=$(curl -sS -m 5 -w '\n%{http_code}' "$BASE/selection" 2>/dev/null) || { echo "{\"ok\":false,\"error\":\"Couldn't reach the daemon ($BASE)\"}"; exit 3; }
    CODE="${RES##*$'\n'}"; BODY="${RES%$'\n'*}"
    if [ "$CODE" != "200" ]; then echo "$BODY"; exit 1; fi
    if [ "$REF" = 1 ]; then python3 -c 'import json,sys; print(json.load(sys.stdin)["ref"])' <<<"$BODY"; else echo "$BODY"; fi
    ;;
  paths)
    # 툴체인은 플러그인 버전과 무관해 홈에 둔다 — 지울 때 어디를 지워야 하는지 여기서 보인다.
    . "$ENV_FILE" 2>/dev/null || true
    python3 - "$ROOT" "${PREVUE_LAYOUTLIB:-}" "${PREVUE_COMPILER:-}" "${PREVUE_LIB:-}" "$HOME/.prevue" <<'PY'
import json, os, subprocess, sys
root, layoutlib, compiler, lib, prevuehome = sys.argv[1:6]

def size(p):
    if not p or not os.path.exists(p): return None
    out = subprocess.run(["du", "-sk", p], capture_output=True, text=True).stdout.split()
    return round(int(out[0]) / 1024) if out else None

items = [
    ("plugin", root, "The plugin itself. Installed fresh for each version — so only our own files live here"),
    ("layoutlib", layoutlib, "Shared toolchain. Independent of the plugin version"),
    ("compiler", compiler, "Shared toolchain. Independent of the plugin version"),
    ("lib", lib, "Third-party jars the daemon reads. The name is a hash of the dependency set, so they're downloaded again only when it changes"),
    ("projects", os.path.join(prevuehome, "projects"), "Per-repository classpath dumps · overlays · PNGs"),
]
out = {"ok": True, "paths": [
    {"what": w, "path": p or None, "mb": size(p), "note": n} for w, p, n in items
]}
out["toolchainRoot"] = os.path.join(prevuehome, "toolchain")
out["note"] = "toolchainRoot and projects can be deleted — the next run recreates them"
print(json.dumps(out, ensure_ascii=False))
PY
    ;;
  status)
    ST="$(curl -sf -m 5 "$BASE/status")" || { unreached_json; exit 3; }
    # 같은 저장소에 앱의 데몬이 여럿이면 함께 싣는다 — 뷰어 탭이 왜 둘인지 보이게(D-50).
    if [ -n "${KEY:-}" ]; then repo_daemons "$KEY" | python3 "$PLAN_PY" with-daemons "$ST"; else echo "$ST"; fi ;;
  log) tail -n "${1:-40}" "$LOG" ;;
  stop)
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "--mine" ]; then
      python3 "$ROOT/bin/prevue_prepare.py" stop
      # --mine 은 이 체크아웃이 띄운 데몬만이다 — 워크트리를 치울 때 다른 워크트리의 데몬은 그대로 둔다.
      MINE="$( [ "$1" = "--mine" ] && for lp in $(live_daemons | cut -f1); do printf '%s\t%s\n' "$lp" "$(daemon_status "$lp")"; done \
        | python3 "$PLAN_PY" own "$ROOT" | cut -f1 )"
      # 저장소마다 데몬이 따로 뜨므로 한 번에 쓸어 낼 길이 필요하다. 하나씩 포트를 찾아 치게 두면
      # 그걸 하느니 그냥 켜 두게 된다 — 켜 둔 데몬이 곧 NFR-6 위반이다.
      SENT=""
      while IFS="$(printf '\t')" read -r lp lk lr; do
        [ -n "$lp" ] || continue
        [ "$1" = "--mine" ] && ! printf '%s\n' "$MINE" | grep -qx "$lp" && continue
        use_port "$lp"; post /shutdown '{}' >/dev/null 2>&1
        SENT="$SENT$lp $? {\"port\":$lp,\"repo\":\"$lr\"}"$'\n'
      done <<EOF
$(live_daemons)
EOF
      # 다 보낸 뒤에 기다린다 — 정리는 데몬마다 나란히 돈다. 센 것은 보낸 수가 아니라 실제로 내려간 수다.
      N=0; LIST=""; FAILED=""
      while read -r lp rc item; do
        [ -n "$lp" ] || continue
        if bring_down "$lp" "$rc"; then N=$((N + 1)); LIST="$LIST${LIST:+,}$item"; else FAILED="$FAILED${FAILED:+,}$item"; fi
      done <<EOF
$SENT
EOF
      if [ -n "$FAILED" ]; then
        echo "{\"ok\":false,\"stopped\":$N,\"daemons\":[$LIST],\"failed\":[$FAILED],\"error\":\"Couldn't stop the daemons in failed — they're still running\"}"; exit 1
      fi
      echo "{\"ok\":true,\"stopped\":$N,\"daemons\":[$LIST]}"
    else
      # 앱마다 데몬이 따로라(D-50) 저장소를 가리키면 그 저장소의 데몬을 전부 내린다. 저장소를 못 정했으면 고른 자리 하나다.
      PORTS="$PORT"; [ -n "${KEY:-}" ] && PORTS="$(repo_daemons "$KEY" | cut -f1 | tr '\n' ' ')"
      [ -n "${PORTS// /}" ] || PORTS="$PORT"
      SENT=""
      for lp in $PORTS; do use_port "$lp"; post /shutdown '{}' >/dev/null; SENT="$SENT$lp $? "; done
      DOWN=""; FAILED=""
      set -- $SENT
      while [ $# -ge 2 ]; do
        if bring_down "$1" "$2"; then DOWN="$DOWN${DOWN:+,}$1"; else FAILED="$FAILED${FAILED:+,}$1"; fi
        shift 2
      done
      if [ -n "$FAILED" ]; then
        echo "{\"ok\":false,\"ports\":[$DOWN],\"failed\":[$FAILED],\"error\":\"Couldn't stop the daemons in failed — they're still running\"}"; exit 1
      fi
      echo "{\"ok\":true,\"ports\":[$DOWN]}"
    fi ;;
  *) usage ;;
esac
